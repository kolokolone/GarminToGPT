# Aucune variable n'est obligatoire : la configuration se fait dans /connexion
# et /tunnel, et l'image Docker définit PYTHONUNBUFFERED=1.
#
# Optionnel : ces variables sont prioritaires sur les fichiers de configuration.
# GARMIN_PERSONAL_API_KEY=
# CONTROL_PLANE_TUNNEL_ID=
# CONTROL_PLANE_API_KEY=
# OPENAI_API_KEY=
